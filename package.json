{
  "name": "@local/dsh-bionic-memory",
  "version": "0.7.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Bionic Memory Mode: cross-session episodic memory with Ebbinghaus fading, habit schemas, procedural instincts, and NREM/REM dreaming.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "prompt-template.md",
    "README.md",
    "LICENSE",
    "lib",
    "locale",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "bionic",
    "dreaming",
    "ebbinghaus"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
